{
  "driver_cloudxr": {
    "loadPriority": 1,
    "use_windows_key": 3,
    "motion_controllers_personality": 0,
    "enable_hand_tracking": false,
    "allow_fov_tangents": false,
    "horizontal_fov_tangent": 1,
    "vertical_fov_tangent": 1,
    "sharpening": 0,
    "allow_service_start": true,
    "start_cloudxr_service": false,
    "cloudxr_profile": "auto-native",
    "cloudxr_audio_enable": true,
    "cloudxr_streaming_settings": false,
    "cloudxr_foveation_warped_width": 2048,
    "cloudxr_video_buffering": false,
    "cloudxr_use_10_bits": false,
    "cloudxr_foveation_enable": true,
    "cloudxr_foveation_inset": 40,
    "head_prediction_blend": 1,
    "controller_prediction_blend": 0,
    "running_start": 1
  }
}
